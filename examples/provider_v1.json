{
  "server_name": "docs-mcp",
  "tools": {
    "search_docs": {
      "name": "search_docs",
      "description": "Search internal documentation",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "limit": { "type": "integer" }
        },
        "required": ["query"],
        "additionalProperties": false
      }
    },
    "get_doc": {
      "name": "get_doc",
      "description": "Fetch a document by id",
      "inputSchema": {
        "type": "object",
        "properties": {
          "doc_id": { "type": "string" }
        },
        "required": ["doc_id"]
      }
    }
  }
}
